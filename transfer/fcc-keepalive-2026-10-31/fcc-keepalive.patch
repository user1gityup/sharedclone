+@pytest.mark.asyncio
+async def test_anthropic_idle_stream_emits_ping_keepalives() -> None:
+    resume = asyncio.Event()
+
+    async def body() -> AsyncGenerator[str]:
+        yield 'event: message_start\ndata: {"type":"message_start"}\n\n'
+        await resume.wait()
+        yield 'event: message_stop\ndata: {"type":"message_stop"}\n\n'
+
+    response = await anthropic_sse_streaming_response(
+        body(),
+        pre_start_error_response=_json_error,
+        request_id="req_test",
+    )
+    assert isinstance(response, StreamingResponse)
+    iterator = cast(Any, response.body_iterator)
+    iterator._keepalive_seconds = 0.01
+    first = await anext(iterator)
+    assert "message_start" in str(first)
+
+    pings = [await anext(iterator), await anext(iterator)]
+    assert all(json.loads(str(p).split("data: ")[1])["type"] == "ping" for p in pings)
+
+    resume.set()
+    tail = [str(chunk) async for chunk in iterator]
+    events = parse_sse_text("".join(tail))
+    assert [e.event for e in events if e.event != "ping"] == ["message_stop"]
+
