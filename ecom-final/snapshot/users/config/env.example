# users service environment — copy to .env.local for local development.
# Placeholder values only. Never commit real secrets.
#
# There is NO symmetric JWT secret in this service by design: sessions are
# signed with an asymmetric Ed25519 key, and storefronts verify with the
# public key only (published at /.well-known/jwks.json).

# PostgreSQL connection string for the production store. The build-time/dev
# runtime uses an in-memory repository (src/lib/db.ts), so this is only needed
# when a real database layer is wired in. (required in production)
DATABASE_URL=postgresql://<db-user>:<db-password>@localhost:5432/users

# Ed25519 private key, PKCS#8 PEM. THIS SERVICE ONLY; never shipped to a storefront.
# Generate with: node -e "const c=require('crypto');const{p}=c.generateKeyPairSync('ed25519');console.log(p.export({type:'pkcs8',format:'pem'}))"
# (required in production; a dev ephemeral key is generated when unset)
SESSION_PRIVATE_KEY_PEM=<SESSION_PRIVATE_KEY_PEM>

# Corresponding public key (SPKI PEM). Derived from the private key; provided here
# for operator visibility and startup checks only.
SESSION_PUBLIC_KEY_PEM=<SESSION_PUBLIC_KEY_PEM>

# Opaque key id published in the JWKS `kid` and the JWT header `kid`.
# Derived from the public key when unset.
SESSION_KEY_ID=<session-key-kid>

# `iss` claim embedded in every signed token. (required)
SESSION_ISSUER=http://localhost:3000

# Default `aud` claim when a client does not pass one. (required)
SESSION_AUDIENCE=storefront

# Access-token lifetime in seconds. (required, default 900)
SESSION_TTL_SECONDS=900

# Refresh-token lifetime in seconds. (required, default 2592000 = 30 days)
REFRESH_TTL_SECONDS=2592000

# Outbound mail (SMTP URL) for verification and password-reset emails. Optional
# in dev (the mailer is a no-op); required for real email delivery.
SMTP_URL=

# From address for outbound mail.
MAIL_FROM=users@example.com

# Public base URL of this service, used for OAuth redirect URIs and email links.
APP_BASE_URL=http://localhost:3000

# Google OAuth credentials (optional; OAuth routes return 503 when unset).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Meta (Facebook) OAuth credentials (optional; OAuth routes return 503 when unset).
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=

# Issuer label shown in authenticator apps during TOTP enrollment.
TOTP_ISSUER=users

# Number of reverse proxies we control in front of this app. The client IP
# resolver trusts this many hops from the right of X-Forwarded-For.
RATE_LIMIT_TRUSTED_PROXY_COUNT=1

# development | test | production
NODE_ENV=development
