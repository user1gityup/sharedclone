# Commerce Storefront — Environment Variables
# This service VERIFIES session tokens with the users service public key only.
# It holds NO signing key, mints NO sessions, and has NO cannabis/licence configuration.
# Every value shown is an obviously fake placeholder — replace with real values.
# Solana runs on devnet only.

# --- Required ---

# MySQL connection string (Prisma format)
DATABASE_URL=mysql://user:password@localhost:3306/commerce

# Base URL of this storefront (used for redirects, webhooks)
APP_BASE_URL=http://localhost:3000

# Users service JWKS endpoint for EdDSA Ed25519 token verification
USERS_JWKS_URL=http://localhost:3001/.well-known/jwks.json

# Expected issuer claim in tokens from the users service
USERS_ISSUER=http://localhost:3001

# Expected audience claim — must match what the users service mints for this storefront
USERS_AUDIENCE=commerce

# --- Optional (app starts without these in mock/sandbox mode) ---

# Stripe secret key — absent = sandbox mode (no real charges)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=

# Stripe Connect client ID for vendor onboarding
STRIPE_CONNECT_CLIENT_ID=

# Solana cluster (always devnet)
SOLANA_CLUSTER=devnet

# Solana RPC endpoint (devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana treasury public key
SOLANA_TREASURY_PUBKEY=

# Manual crypto confirmations required before funds are considered settled
MANUAL_CRYPTO_CONFIRMATIONS_REQUIRED=3

# S3-compatible object storage endpoint (for file uploads)
OBJECT_STORAGE_ENDPOINT=

# Object storage bucket name
OBJECT_STORAGE_BUCKET=commerce-uploads

# Object storage access key
OBJECT_STORAGE_KEY=

# Object storage secret key
OBJECT_STORAGE_SECRET=

# SMTP connection URL (for transactional email)
SMTP_URL=

# From address for transactional email
MAIL_FROM=noreply@example.com

# Trusted proxy count for client IP derivation (rate limiting)
RATE_LIMIT_TRUSTED_PROXY_COUNT=1

# Node environment
NODE_ENV=development
