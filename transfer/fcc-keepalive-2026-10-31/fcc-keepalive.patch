+RATE_LIMIT_COOLDOWN_SECONDS = 600.0
+
+
+class _RateLimitCooldowns:
+    """Process-wide record of models whose rate-limit retries were just exhausted.
+
+    While a model cools down, requests with a fallback skip it instead of spending
+    its full retry budget again; the last candidate is always still tried.
+    """
+
+    def __init__(self, seconds: float = RATE_LIMIT_COOLDOWN_SECONDS) -> None:
+        self.seconds = seconds
+        self._until: dict[str, float] = {}
+
+    def start(self, model_ref: str) -> None:
+        self._until[model_ref] = monotonic() + self.seconds
+
+    def clear(self, model_ref: str) -> None:
+        self._until.pop(model_ref, None)
+
+    def active(self, model_ref: str) -> bool:
+        until = self._until.get(model_ref)
+        if until is None:
+            return False
+        if monotonic() >= until:
+            del self._until[model_ref]
+            return False
+        return True
+
+
+_rate_limit_cooldowns = _RateLimitCooldowns()
+
 
