<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Project Manager</title>
<style>
:root { --bg:#f6f7f9; --panel:#fff; --ink:#1b1f24; --muted:#636c76; --line:#d8dde3; --accent:#2f6fde; --warn:#b54708; --warn-bg:#fff4e5; --ok:#1a7f37; --bad:#c62828; }
@media (prefers-color-scheme: dark) { :root { --bg:#111418; --panel:#1a1f25; --ink:#e6e9ed; --muted:#98a2ad; --line:#2d353e; --accent:#6ea0ff; --warn:#ffb86b; --warn-bg:#33240f; --ok:#57c26f; --bad:#ff7b72; } }
* { box-sizing: border-box; }
body { margin:0; font:14px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; background:var(--bg); color:var(--ink); }
header { display:flex; gap:8px; flex-wrap:wrap; align-items:center; padding:10px 16px; background:var(--panel); border-bottom:1px solid var(--line); position:sticky; top:0; z-index:2; }
header h1 { font-size:15px; margin:0 12px 0 0; }
input, select, textarea, button { font:inherit; color:inherit; background:var(--panel); border:1px solid var(--line); border-radius:6px; padding:5px 8px; }
button { cursor:pointer; } button.primary { background:var(--accent); color:#fff; border-color:var(--accent); }
textarea { width:100%; min-height:90px; resize:vertical; }
main { display:grid; grid-template-columns:repeat(6, minmax(190px, 1fr)); gap:10px; padding:12px 16px; overflow-x:auto; }
.col h2 { font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); margin:4px 2px 8px; }
.card { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:8px 10px; margin-bottom:8px; cursor:pointer; }
.card:hover { border-color:var(--accent); }
.card .meta { color:var(--muted); font-size:12px; margin-top:4px; }
.tag { display:inline-block; font-size:11px; border:1px solid var(--line); border-radius:10px; padding:0 6px; margin-right:4px; }
aside { position:fixed; top:0; right:0; bottom:0; width:min(560px, 100%); background:var(--panel); border-left:1px solid var(--line); padding:16px; overflow-y:auto; z-index:3; display:none; }
aside.open { display:block; }
.row { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin:8px 0; }
.item { border:1px solid var(--line); border-radius:6px; padding:6px 8px; margin:6px 0; }
.instruction { border:2px solid var(--warn); background:var(--warn-bg); }
.instruction .label { font-weight:700; color:var(--warn); }
.muted { color:var(--muted); font-size:12px; }
.error { color:var(--bad); white-space:pre-wrap; }
.conflict { border:2px solid var(--bad); border-radius:6px; padding:8px; margin:8px 0; }
h3 { font-size:13px; margin:16px 0 4px; }
@media (max-width:700px) { main { grid-template-columns:1fr; } }
</style>
</head>
<body>
<header>
  <h1>Project Manager</h1>
  <select id="project" aria-label="Project"></select>
  <button id="newProject">New project</button>
  <button id="newTask" class="primary">New task</button>
  <input id="search" placeholder="Search" aria-label="Search">
  <span style="flex:1"></span>
  <label class="muted">You <input id="actor" size="12" placeholder="your name"></label>
</header>
<main id="board"></main>
<aside id="panel"></aside>
<script>
const STATUSES = ['todo', 'in_progress', 'review', 'blocked', 'uncertain', 'done']
const $ = (id) => document.getElementById(id)
const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]))
const store = { get: (k) => { try { return localStorage.getItem(k) } catch { return null } }, set: (k, v) => { try { localStorage.setItem(k, v) } catch {} } }
let openTask = null, lastEvent = 0

$('actor').value = store.get('pm.actor') || ''
$('actor').onchange = () => store.set('pm.actor', $('actor').value.trim())

async function api(method, path, body) {
  const actor = $('actor').value.trim()
  const headers = { 'content-type': 'application/json' }
  if (actor) headers['x-pm-actor'] = actor
  const token = store.get('pm.token')
  if (token) headers.authorization = 'Bearer ' + token
  const res = await fetch(path, { method, headers, body: body ? JSON.stringify(body) : undefined })
  const data = await res.json()
  if (res.status === 401) { const t = prompt('Access token for this server'); if (t) { store.set('pm.token', t); return api(method, path, body) } }
  if (!res.ok) { const e = new Error(data.error); e.status = res.status; e.data = data; throw e }
  return data
}
const needActor = () => { if ($('actor').value.trim()) return true; alert('Enter your name (top right) first: every change is attributed.'); $('actor').focus(); return false }

async function loadProjects() {
  const projects = await api('GET', '/api/projects')
  const current = $('project').value || store.get('pm.project')
  $('project').innerHTML = projects.map((p) => `<option value="${p.id}">${esc(p.name)} (${p.done_count}/${p.task_count})</option>`).join('') || '<option value="">no projects yet</option>'
  if (projects.some((p) => p.id === current)) $('project').value = current
}

async function loadBoard() {
  const project = $('project').value
  if (!project) { $('board').innerHTML = '<p class="muted">Create a project to start.</p>'; return }
  const tasks = await api('GET', `/api/tasks?project=${project}&q=${encodeURIComponent($('search').value)}`)
  $('board').innerHTML = STATUSES.map((s) => `<section class="col"><h2>${s.replace('_', ' ')} (${tasks.filter((t) => t.status === s).length})</h2>
    ${tasks.filter((t) => t.status === s).map((t) => `<div class="card" tabindex="0" data-id="${t.id}">
      <div>${esc(t.title)}</div>
      <div class="meta"><span class="tag">p${t.priority}</span>${t.claimed_by ? `<span class="tag">claimed: ${esc(t.claimed_by)}</span>` : ''}${t.assignee ? `<span class="tag">for ${esc(t.assignee)}</span>` : ''}</div>
    </div>`).join('')}</section>`).join('')
  document.querySelectorAll('.card').forEach((c) => { c.onclick = () => showTask(c.dataset.id); c.onkeydown = (e) => { if (e.key === 'Enter') showTask(c.dataset.id) } })
}

async function showTask(id, conflict) {
  const t = await api('GET', `/api/tasks/${id}`)
  openTask = t
  const p = $('panel')
  p.className = 'open'
  p.innerHTML = `
    <div class="row"><strong style="flex:1">${esc(t.id)} · rev ${t.rev}</strong><button id="close">Close</button></div>
    ${conflict ? `<div class="conflict"><strong>Not saved: someone changed this task first.</strong> The form now shows the current version. Your rejected edit is kept here to merge:<pre style="white-space:pre-wrap">${esc(JSON.stringify(conflict, null, 2))}</pre></div>` : ''}
    <input id="title" value="${esc(t.title)}" style="width:100%" aria-label="Title">
    <div class="row">
      <label>Status <select id="status">${STATUSES.map((s) => `<option ${s === t.status ? 'selected' : ''}>${s}</option>`).join('')}</select></label>
      <label>Priority <select id="priority">${[1, 2, 3].map((n) => `<option ${n === t.priority ? 'selected' : ''}>${n}</option>`).join('')}</select></label>
      <label>Assignee <input id="assignee" size="12" value="${esc(t.assignee ?? '')}"></label>
    </div>
    <textarea id="body" aria-label="Requirements">${esc(t.body)}</textarea>
    <div class="row"><button class="primary" id="save">Save</button>
      ${t.claimed_by ? `<span class="muted">Claimed by ${esc(t.claimed_by)}${t.claim_model ? ` (${esc(t.claim_model)})` : ''} until ${esc(t.lease_until)}</span> <button id="release">Release</button>` : '<button id="claim">Claim</button>'}
    </div>
    <div id="err" class="error"></div>
    <h3>Discussion and instructions</h3>
    ${t.comments.map((c) => c.kind === 'instruction'
      ? `<div class="item instruction"><span class="label">INSTRUCTION</span> <span class="muted">#${c.id} ${esc(c.actor)} · ${esc(c.created_at)} · ${c.acked_by ? `acknowledged by ${esc(c.acked_by)}` : '<strong>not acknowledged</strong>'}</span><div>${esc(c.body)}</div>${c.acked_by ? '' : `<button data-ack="${c.id}">Acknowledge</button>`}</div>`
      : `<div class="item"><span class="muted">${esc(c.actor)}${c.model ? ` (${esc(c.model)})` : ''} · ${esc(c.created_at)}</span><div>${esc(c.body)}</div></div>`).join('') || '<p class="muted">None yet.</p>'}
    <textarea id="comment" placeholder="Write a comment"></textarea>
    <div class="row"><button id="addComment">Comment</button><button id="addInstruction">Submit as instruction</button></div>
    <h3>Artifacts and continuation briefs</h3>
    ${t.artifacts.map((a) => `<div class="item"><span class="tag">${esc(a.kind)}</span> ${esc(a.ref)} <span class="muted">${esc(a.actor)} · ${esc(a.created_at)}</span>${a.note ? `<div style="white-space:pre-wrap">${esc(a.note)}</div>` : ''}</div>`).join('') || '<p class="muted">None yet.</p>'}
    <h3>History</h3>
    ${t.history.slice().reverse().map((e) => `<div class="muted">${esc(e.at)} · <strong>${esc(e.actor)}</strong>${e.model ? ` (${esc(e.model)})` : ''} · ${esc(e.action)}</div>`).join('')}`
  const fail = (e) => { $('err').textContent = e.message }
  $('close').onclick = () => { p.className = ''; openTask = null }
  $('save').onclick = async () => {
    if (!needActor()) return
    const edit = { rev: t.rev, title: $('title').value, body: $('body').value, status: $('status').value, priority: Number($('priority').value), assignee: $('assignee').value || null }
    try { await api('PATCH', `/api/tasks/${t.id}`, edit); await refresh() }
    catch (e) { if (e.status === 409) { await showTask(t.id, e.data.rejected) } else fail(e) }
  }
  if ($('claim')) $('claim').onclick = async () => { if (!needActor()) return; try { await api('POST', `/api/tasks/${t.id}/claim`, {}); await refresh() } catch (e) { fail(e) } }
  if ($('release')) $('release').onclick = async () => {
    if (!needActor()) return
    const mine = t.claimed_by === $('actor').value.trim()
    if (!mine && !confirm(`Take back ${t.claimed_by}'s claim?`)) return
    try { await api('POST', `/api/tasks/${t.id}/release`, { force: !mine }); await refresh() } catch (e) { fail(e) }
  }
  const comment = (kind) => async () => { if (!needActor() || !$('comment').value.trim()) return; try { await api('POST', `/api/tasks/${t.id}/comments`, { body: $('comment').value, kind }); await refresh() } catch (e) { fail(e) } }
  $('addComment').onclick = comment('comment')
  $('addInstruction').onclick = comment('instruction')
  p.querySelectorAll('[data-ack]').forEach((b) => { b.onclick = async () => { if (!needActor()) return; try { await api('POST', `/api/comments/${b.dataset.ack}/ack`); await refresh() } catch (e) { fail(e) } } })
}

async function refresh() {
  await loadProjects()
  await loadBoard()
  if (openTask) await showTask(openTask.id)
}

$('project').onchange = () => { store.set('pm.project', $('project').value); loadBoard() }
$('search').oninput = () => loadBoard()
$('newProject').onclick = async () => {
  if (!needActor()) return
  const name = prompt('Project name'); if (!name) return
  try { const p = await api('POST', '/api/projects', { name }); store.set('pm.project', p.id); $('project').value = p.id; await refresh() } catch (e) { alert(e.message) }
}
$('newTask').onclick = async () => {
  if (!needActor() || !$('project').value) return
  const title = prompt('Task title'); if (!title) return
  try { const t = await api('POST', '/api/tasks', { project: $('project').value, title }); await refresh(); await showTask(t.id) } catch (e) { alert(e.message) }
}

// Live updates: poll the event feed; redraw only when something changed and
// the user is not mid-edit in the panel.
setInterval(async () => {
  try {
    const events = await api('GET', `/api/events?since=${lastEvent}&limit=500`)
    if (!events.length) return
    lastEvent = events[events.length - 1].id
    const editing = openTask && ['title', 'body', 'comment', 'assignee'].includes(document.activeElement?.id)
    await loadProjects(); await loadBoard()
    if (openTask && !editing) await showTask(openTask.id)
  } catch {}
}, 4000)

;(async () => {
  const events = await api('GET', '/api/events?since=0&limit=2000')
  lastEvent = events.length ? events[events.length - 1].id : 0
  await refresh()
})()
</script>
</body>
</html>
